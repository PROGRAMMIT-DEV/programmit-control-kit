{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "programmit-control",
  "permission": {
    "edit": {
      "**": "deny",
      "PROJECT_ROOT/**": "allow",
      "PROJECT_ROOT/opencode.json": "deny",
      "PROJECT_ROOT/.opencode/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git commit --amend*": "deny",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "docker volume rm*": "deny",
      "npx prisma migrate reset*": "deny",
      "psql *drop database*": "deny",
      "*opencode.json*": "deny",
      "*/.opencode/*": "deny",
      "*KNOWLEDGE.md*": "deny",
      "*PROGRAMMIT_POLICY.md*": "deny"
    }
  }
}
