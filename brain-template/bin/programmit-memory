#!/usr/bin/env python3

import argparse
import json
import re
import sqlite3
from datetime import datetime
from pathlib import Path

BRAIN = Path(__file__).resolve().parent.parent
DB = BRAIN / "memory-index.sqlite"

SOURCES = {
    "learning": BRAIN / "LEARNINGS.jsonl",
    "decision": BRAIN / "DECISIONS.jsonl",
    "error": BRAIN / "ERRORS.jsonl",
    "preference": BRAIN / "USER_PREFERENCES.jsonl",
}

# Constantes de Ponderación
# Jerarquía: Status > Tipo > Relevancia
CONFIDENCE_WEIGHT = 1000  # VERIFIED >> PROVISIONAL
KIND_WEIGHT = 100         # DECISION > LEARNING > PREFERENCE > ERROR
RELEVANCE_WEIGHT = 10     # Decide entre memorias del mismo Status y Tipo
RECENCY_WEIGHT = 1        # Desempate menor

# Pesos de Relevancia (relativos, sumados a RELEVANCE_WEIGHT)
EXACT_MATCH_WEIGHT = 50
KEY_MATCH_WEIGHT = 30
AREA_MATCH_WEIGHT = 20
CONTENT_MATCH_WEIGHT = 10

# Mapeo de prioridades de tipo
KIND_PRIORITY = {
    "decision": 4,
    "learning": 3,
    "error": 2,
    "preference": 1,
}

def db():
    con = sqlite3.connect(DB)
    con.execute("""
        CREATE TABLE IF NOT EXISTS memories (
            id INTEGER PRIMARY KEY,
            kind TEXT NOT NULL,
            source_line INTEGER NOT NULL,
            canonical_key TEXT,
            area TEXT,
            verified INTEGER DEFAULT 0,
            status TEXT,
            date TEXT,
            content TEXT NOT NULL,
            UNIQUE(kind, source_line)
        )
    """)
    # Manejo simple de esquema para este script aislado
    try:
        con.execute("ALTER TABLE memories ADD COLUMN canonical_key TEXT")
        con.execute("ALTER TABLE memories ADD COLUMN status TEXT")
        con.execute("ALTER TABLE memories ADD COLUMN date TEXT")
    except sqlite3.OperationalError:
        pass
    return con

def reindex():
    con = db()
    con.execute("DELETE FROM memories")

    for kind, path in SOURCES.items():
        if not path.exists():
            continue

        for n, raw in enumerate(path.read_text(errors="ignore").splitlines(), 1):
            if not raw.strip():
                continue

            try:
                obj = json.loads(raw)
            except Exception:
                continue

            status = str(obj.get("status") or "").upper()

            # Memoria obsoleta nunca entra al índice.
            if status == "OBSOLETE":
                continue

            # Canonical Key V2.4
            key = str(obj.get("canonicalKey") or obj.get("key") or "")
            area = str(obj.get("area") or "")
            verified = 1 if obj.get("verified") is True or status == "VERIFIED" else 0

            # Learnings con verification PASS cuentan como verificados.
            verification = obj.get("verification")
            if isinstance(verification, dict):
                if any(str(v).upper().startswith("PASS") for v in verification.values()):
                    verified = 1
            
            date_str = str(obj.get("date") or "")
            content = json.dumps(obj, ensure_ascii=False)

            con.execute("""
                INSERT OR REPLACE INTO memories
                (kind, source_line, canonical_key, area, verified, status, date, content)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (kind, n, key, area, verified, status, date_str, content))

    con.commit()
    con.close()

def terms(q):
    return [
        x.lower()
        for x in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9_./-]+", q)
        if len(x) >= 2
    ]

def calculate_score(row, query_terms):
    kind, canonical_key, area, verified, status, date, content = row
    
    # 1. Confianza (Status)
    # VERIFIED = 1, PROVISIONAL = 0
    confidence = 1 if verified else 0
    score_confidence = confidence * CONFIDENCE_WEIGHT

    # 2. Tipo
    kind_prio = KIND_PRIORITY.get(kind, 0)
    score_kind = kind_prio * KIND_WEIGHT

    # 3. Relevancia
    score_relevance = 0
    
    # Normalización para comparación
    c_key = canonical_key.lower()
    c_area = area.lower()
    c_content = content.lower()
    q_str = " ".join(query_terms)

    # Coincidencia Exacta (Canonical Key)
    # Si la query es exactamente la canonical key
    if q_str == c_key:
        score_relevance += EXACT_MATCH_WEIGHT
    
    # Coincidencia en Key (Token matching)
    # Si tokens de la query aparecen en la key
    key_hits = sum(1 for t in query_terms if t in c_key)
    if key_hits > 0:
        score_relevance += (key_hits / len(query_terms)) * KEY_MATCH_WEIGHT
        
        # Bonus por usar la herramienta específica
        if "use" in q_str and "tool" in q_str and "update_system_prompt" in c_key:
            score_relevance += 20

    # Coincidencia en Area
    area_hits = sum(1 for t in query_terms if t in c_area)
    if area_hits > 0:
        score_relevance += (area_hits / len(query_terms)) * AREA_MATCH_WEIGHT

    # Coincidencia en Contenido
    # Solo si ya hay algo de relevancia para evitar ruido
    if score_relevance > 0 or len(query_terms) == 1:
        content_hits = sum(1 for t in query_terms if t in c_content)
        if content_hits > 0:
            score_relevance += (content_hits / len(query_terms)) * CONTENT_MATCH_WEIGHT

    # 4. Recencia
    score_recency = 0
    if date:
        try:
            # Intento de parseo simple
            d = datetime.fromisoformat(date.replace("Z", "+00:00"))
            days_old = (datetime.now(d.tzinfo) - d).days
            # Menor puntaje para memorias viejas, pero siempre positivo para desempate
            score_recency = max(0, (365 - days_old)) * 0.01 # Escala muy pequeña
        except:
            pass

    # Total: Jerarquía estricta
    # 1. Confianza (1000*verified)
    # 2. Tipo (100*prio)
    # 3. Relevancia (10*rel) -> Desempate entre tipos iguales
    # 4. Recencia (desempate menor)
    total = (score_confidence * CONFIDENCE_WEIGHT) + (score_kind * KIND_WEIGHT) + (score_relevance * RELEVANCE_WEIGHT) + (score_recency * RECENCY_WEIGHT)
    
    return total

def search(query, limit, debug=False):
    if not DB.exists():
        reindex()

    con = db()
    # Seleccionamos todos los campos necesarios
    rows = con.execute(
        "SELECT kind, canonical_key, area, verified, status, date, content FROM memories"
    ).fetchall()
    con.close()

    qs = terms(query)
    if not qs:
        return

    scored = []

    for row in rows:
        kind, canonical_key, area, verified, status, date, content = row
        
        # Exigir al menos alguna coincidencia real (OPTIMIZACIÓN)
        # Si no hay coincidencia en contenido, clave o area, no tiene sentido puntuar alto
        # Pero mantenemos la regla: "Una memoria que no tenga ninguna coincidencia real NO debe aparecer"
        haystack = f"{canonical_key} {area} {content}".lower()
        if not any(t in haystack for t in qs):
            continue

        score = calculate_score(row, qs)
        
        # Guardamos info extra para debug
        debug_info = f"{score} | {status} | {kind} | {canonical_key}"
        scored.append((score, content, debug_info))

    # Ordenar por puntaje descendente
    scored.sort(key=lambda x: x[0], reverse=True)

    for content, debug_info in [(x[1], x[2]) for x in scored[:limit]]:
        if debug:
            print(f"{debug_info}")
        print(content)

def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("reindex")

    s = sub.add_parser("search")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=3)
    s.add_argument("--debug-score", action="store_true", help="Show scoring details")

    args = p.parse_args()

    if args.cmd == "reindex":
        reindex()
        return

    if args.cmd == "search":
        search(args.query, max(1, min(args.limit, 5)), args.debug_score)

if __name__ == "__main__":
    main()
